# Database (Neon Postgres via Vercel Marketplace)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cron auth — random string used to authorize Vercel Cron requests
CRON_SECRET=""

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="" # Empatify YouTube channel ID (UC...)

# Instagram Graph API — https://developers.facebook.com/
# Requires IG Business/Creator account connected to a Facebook Page
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Facebook Graph API — same Meta app as Instagram
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""

# TikTok — https://developers.tiktok.com/
# Display API: limited public metrics. Research/Business API: needs approval.
TIKTOK_ACCESS_TOKEN=""
TIKTOK_OPEN_ID=""
